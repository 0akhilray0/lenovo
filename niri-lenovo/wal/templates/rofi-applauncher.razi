* {
    /* Global Settings mapped to Pywal variables */
    font:                        "JetBrains Mono Nerd Font 11";
    background-color:            transparent;
    text-color:                  {foreground};
    spacing:                     0;
    separatorcolor:              transparent;
}

window {
    location:                    center;
    anchor:                      center;
    width:                       400px;
    enabled:                     true;
    margin:                      0px;
    padding:                     25px;
    border:                      1px;
    border-radius:               0px;
    border-color:                {color2}4D; /* 30% glowing border */
    background-color:            {background}D9; /* 85% glass background */
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    spacing:                     15px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     12px;
    border:                      1px;
    border-radius:               0px;
    border-color:                {color2}4D; 
    background-color:            {background}73; /* 45% glass search bar */
    text-color:                  {foreground};
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  {color2}; 
    font:                        "JetBrains Mono Nerd Font Bold 11";
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           {color8};
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       4;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     8px;
    margin:                      5px 0px 0px 0px;
    padding:                     0px;
    text-color:                  {foreground};
    cursor:                      "default";
}

element {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     10px;
    border:                      0px;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  {foreground};
    cursor:                      pointer;
}

element selected.normal {
    background-color:            {color2}60; /* Transparent glass accent */
    text-color:                  {background};
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        40px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

error-message {
    padding:                     20px;
    border:                      2px;
    border-radius:               0px;
    border-color:                {color2};
    background-color:            {background}D9;
    text-color:                  {foreground};
}
